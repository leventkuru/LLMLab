{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // DNS rebinding'e karşı: yerel MCP sunucusu yalnızca bu ana makine adlarıyla çağrılabilir.
  "AllowedHosts": "localhost;127.0.0.1",

  "Urls": "http://localhost:5103",

  // Sınırlar burada: model değiştiremez. İmaj yerelde önceden bulunmalıdır: docker pull python:3.12-slim
  "Sandbox": {
    "DockerBinary": "docker",
    "Image": "python:3.12-slim",
    "DefaultTimeoutSeconds": 10,
    "MaxTimeoutSeconds": 60,
    "MemoryMb": 256,
    "Cpus": 1.0,
    "PidsLimit": 64,
    "TmpfsMb": 16,
    "MaxOutputChars": 8000,
    "MaxCodeChars": 20000,
    "MaxConcurrent": 2
  }
}
