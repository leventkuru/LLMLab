{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // DNS rebinding'e karşı: yalnızca bu ana makine adlarıyla çağrılabilir.
  "AllowedHosts": "localhost;127.0.0.1",
  "Urls": "http://localhost:5201",

  "A2AHost": {
    // Ajan kartlarında yayınlanan, istemcilerin göreceği adres.
    "PublicBaseUrl": "http://localhost:5201"
  },

  // Ajan çalışma zamanı ana API ile aynı ayarları kullanır: aynı model, aynı MCP sunucuları, aynı kayıt defteri.
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "qwen3:8b",
    "EmbeddingModel": "qwen3-embed-cpu"
  },
  "Agent": { "MaxHistoryMessages": 20, "ContextTokens": 8192 },
  "Rag": { "ChatTopK": 4, "MinScore": 0.42, "KeywordFloor": 0.30 },
  "Mcp": {
    "Servers": [
      { "Name": "tools", "Url": "http://localhost:5101/mcp" },
      { "Name": "documents", "Url": "http://localhost:5102/mcp", "OnlyWithDocuments": true },
      { "Name": "sandbox", "Url": "http://localhost:5103/mcp" }
    ]
  },
  "Telemetry": { "Enabled": false }
}
