{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Arayüzün çalıştığı kökenler. Yeni bir köken eklemek için ortam değişkeni: Cors__Origins__2=http://...
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:5174" ]
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "qwen3:8b",
    "EmbeddingModel": "qwen3-embed-cpu"
  },

  "Agent": {
    "MaxHistoryMessages": 20,
    "ContextTokens": 8192
  },

  // Ajanın araçları MCP sunucularından gelir (agent-api ajanın kendisinde araç barındırmaz). Sunucu eklemek: buraya
  // bir giriş; ortam değişkeni: Mcp__Servers__2__Name / Mcp__Servers__2__Url. Sunucu kapalıysa ajan onsuz çalışır.
  "Mcp": {
    "Servers": [
      { "Name": "tools", "Url": "http://localhost:5101/mcp" },
      { "Name": "documents", "Url": "http://localhost:5102/mcp", "OnlyWithDocuments": true },
      { "Name": "sandbox", "Url": "http://localhost:5103/mcp" }
    ]
  },

  // Koordinatör ajanın alt ajan görevleri (süreç içi; faz 3'te Dapr).
  "SubAgents": {
    "MaxConcurrent": 2,
    "MaxActive": 8,
    "TimeoutSeconds": 300,
    "MaxResultChars": 6000,
    "RetainFinished": 100
  },

  "Rag": {
    "ChunkChars": 600,
    "OverlapChars": 100,
    "ChatTopK": 4,
    "MinScore": 0.42,
    "KeywordFloor": 0.30,
    "KeywordBoost": 0.05
  },

  // OpenTelemetry. Standart OTEL_* ortam değişkenleri (ör. OTEL_EXPORTER_OTLP_ENDPOINT) de geçerlidir.
  "Telemetry": {
    "Enabled": true,
    "ServiceName": "LlmLab.Api",
    "OtlpEndpoint": "",          // örn. http://localhost:4317 (Aspire Dashboard / OTel Collector). Boş = dışarı gönderme
    "Console": false,            // izleri/metrikleri/günlükleri konsola da yaz (denemek için)
    "CaptureSensitiveData": false // mesaj / cevap / belge metinlerini izlere yazma (gizlilik)
  },

  "Database": {
    "MigrateOnStartup": false
  }
}
