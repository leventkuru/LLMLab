{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // DNS rebinding'e karşı: yerel MCP sunucusu yalnızca bu ana makine adlarıyla çağrılabilir.
  "AllowedHosts": "localhost;127.0.0.1",

  "Urls": "http://localhost:5102",

  // Ajan API'siyle AYNI değerler olmalı: aynı embedding modeli ve aynı RAG ayarları (bkz. agent-api appsettings).
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "qwen3:8b",
    "EmbeddingModel": "qwen3-embed-cpu"
  },

  "Rag": {
    "ChunkChars": 600,
    "OverlapChars": 100,
    "ChatTopK": 4,
    "MinScore": 0.42,
    "KeywordFloor": 0.30,
    "KeywordBoost": 0.05
  },

  "Telemetry": {
    "Enabled": false
  }
}
