{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  // Yerelde, ne olduğunu görmek için mesaj/cevap metinleri izlere yazılır. Üretimde AÇMAYIN.
  "Telemetry": {
    // Yerel Aspire Dashboard'a gönder (docker run ... aspire-dashboard; arayüz http://localhost:18888).
    // 127.0.0.1: konteyner portu yalnızca bu adreste yayınlı. Dashboard kapalıysa uygulama etkilenmez.
    "OtlpEndpoint": "http://127.0.0.1:4317",
    "CaptureSensitiveData": true
  },
  "ConnectionStrings": {
    // Yalnızca yerel geliştirme: Windows kimlik doğrulaması, kendinden imzalı sertifikaya güven.
    // Eski API'den (DevDb) ayrı bir veritabanı kullanır; iki sürüm yan yana karşılaştırılabilsin.
    // Üretimde TrustServerCertificate kullanmayın; parolalı bağlantıları gizli depoda tutun.
    "Default": "Server=localhost;Database=LlmLabAgent;Integrated Security=True;TrustServerCertificate=True"
  }
}
